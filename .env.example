# ============================================================
# WooCommerce Connector — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
# ============================================================

# --- Required: WooCommerce store URL and read-only API keys ---
STORE_URL=http://localhost:8080
WC_CONSUMER_KEY=your_read_only_consumer_key_here
WC_CONSUMER_SECRET=your_read_only_consumer_secret_here

# --- Required for scripts/seed_fake_data.py only (read/write keys) ---
WC_SEED_KEY=your_read_write_consumer_key_here
WC_SEED_SECRET=your_read_write_consumer_secret_here

# --- Optional: transport safety override (dev only, NEVER in production) ---
# Set to true only when STORE_URL is plain HTTP on a non-localhost host.
# WC_ALLOW_INSECURE=false

# --- Optional: PII redaction (default: true) ---
# When true, billing/shipping email, phone, address_1, address_2, postcode,
# and last_name are replaced with "[redacted]".
# Set to false only for authorized internal tooling.
# REDACT_PII=true

# --- Optional: rate limiting (default: 60 requests/minute) ---
# WC_RPM=60

# --- Optional: pagination cap (default: 10 pages max per list call) ---
# WC_MAX_PAGES=10

# --- Optional: retry cap (default: 3 retries for 429/5xx/timeouts) ---
# WC_MAX_RETRIES=3
